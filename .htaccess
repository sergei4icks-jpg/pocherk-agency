# «Почерк» — настройки для хостинга Рег.ру (Apache). На GitHub Pages этот файл не действует.
AddDefaultCharset utf-8
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # только https и без www — ВКЛЮЧИТЬ после выпуска сертификата Let's Encrypt (раскомментировать 3 строки)
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://pocherkagency.ru%{REQUEST_URI} [L,R=301]
  # служебное закрыто снаружи
  RewriteRule ^api/(config|config\.sample)\.php$ - [F,L]
  RewriteRule ^api/data(/|$) - [F,L]
  RewriteRule (^|/)\.(git|DS_Store) - [F,L]
  RewriteRule ^deploy\.sh$ - [F,L]
</IfModule>

<FilesMatch "\.(json|log|sh|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>


<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
